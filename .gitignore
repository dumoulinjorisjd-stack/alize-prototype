node_modules/
package.json
package-lock.json
# Les Cloud Functions ont besoin de leur manifeste versionné pour être déployées.
!functions/package.json
!functions/package-lock.json
# L'outil de purge bêta a besoin de son manifeste versionné.
!tools/beta-purge/package.json
# Les coquilles natives aussi : sans leur manifeste, l'intégration continue
# ne sait pas quoi installer avant de construire le paquet.
!capacitor-android/package.json
!capacitor-android/package-lock.json
