rules_version = '2';

/* Ti-Services — règles de sécurité Firestore (bêta Phase 1)
   Modèle : comptes utilisateurs, dossiers artisans (validés par l'admin),
   demandes (« premier arrivé, premier servi »), messagerie à numéro masqué.
   L'admin est identifié par son e-mail (voir isAdmin — à remplacer par TON e-mail). */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function email() { return request.auth.token.email; }

    // Admin unique Ti-Services (compte du domaine officiel).
    function isAdmin() {
      return signedIn() && email() in ['contact@ti-services.fr'];
    }

    function artisanDoc(id) {
      return get(/databases/$(database)/documents/artisans/$(id)).data;
    }
    function isValidArtisan() {
      return signedIn()
        && exists(/databases/$(database)/documents/artisans/$(uid()))
        && artisanDoc(uid()).status == 'valide';
    }

    // Jetons push de l'admin (FCM). La Cloud Function (Admin SDK) contourne
    // ces règles ; côté client seul l'admin lit/écrit ses jetons.
    match /adminTokens/{token} {
      allow read, write: if isAdmin();
    }

    // Carnet de DÉMARCHAGE (prospection d'artisans à recruter) : outil interne
    // de l'admin — jamais lu ni écrit par un autre compte.
    match /prospects/{pid} {
      allow read, write: if isAdmin();
    }

    // Jetons de rafraîchissement Mollie (Connect) : SECRET absolu. Seul le serveur
    // (Admin SDK, qui contourne ces règles) y accède, pour re-vérifier l'onboarding
    // d'un artisan. Aucun accès client — même l'artisan concerné ne doit pas lire
    // son propre refresh-token.
    match /mollieTokens/{uid} {
      allow read, write: if false;
    }

    // Propriété des jetons FCM par APPAREIL : chaque jeton appartient au DERNIER compte
    // qui l'a enregistré. Un utilisateur connecté peut (ré)clamer un jeton en s'y
    // désignant propriétaire — ce qui COUPE les notifications d'un ancien compte encore
    // associé au même appareil (ex. ex-artisan devenu client). La Cloud Function
    // (Admin SDK) contourne ces règles pour filtrer les envois.
    match /fcmOwners/{token} {
      allow read:  if isAdmin() || (signedIn() && resource.data.uid == uid());
      allow write: if signedIn() && request.resource.data.uid == uid();
    }

    // Catalogue partagé (services « Autre » ajoutés par l'admin) : lu par tous
    // (les clients doivent voir les services proposés), écrit par l'admin seul.
    match /settings/{doc} {
      /* LE CATALOGUE EST PUBLIC, L'ENTONNOIR NE L'EST PAS (23/10/2026). Le catalogue,
         les disponibilités et la grille de prix s'affichent AVANT toute connexion —
         l'application les charge au démarrage pour tout le monde, visiteur compris —
         et ils restent donc lisibles de tous. Les compteurs de l'entonnoir
         d'installation (`installFunnel_*`) vivaient dans le même espace et partaient
         avec : ils ne regardent que l'éditeur, et seule sa console les lit. */
      allow read: if isAdmin() || !doc.matches('installFunnel.*');
      allow write: if isAdmin();
    }

    // Profils utilisateurs (client et/ou artisan)
    match /users/{userId} {
      allow read:   if isAdmin() || uid() == userId;
      allow create: if uid() == userId;
      // L'utilisateur met à jour sa fiche, MAIS l'accusé de lecture côté Ti-Services
      // (supReadAdmin) reste écrit par l'admin seul — sinon on pourrait feindre un « Lu ».
      /* LES IDENTIFIANTS MOLLIE DU CLIENT SONT ÉCRITS PAR LE SERVEUR (23/10/2026).
         `mollieCustomerId` et `mollieMandateId` arrivent du webhook Mollie, et le
         serveur s'en sert pour PRÉLEVER HORS SESSION : `mollieChargeComplement` lit
         l'identifiant sur la fiche, liste les mandats de ce client et débite sans
         aucune interaction (pourboire, heures en plus). Laissés libres, il suffisait
         de poser l'identifiant d'un tiers sur sa propre fiche pour faire débiter SA
         carte — et, au passage, pour lire ses mandats par le diagnostic de carte et
         pour révoquer le sien. Le seul verrou était qu'un `cst_…` ne se devine pas.
         C'est exactement la discipline déjà appliquée aux champs Mollie d'`artisans`
         (l. 143-156) ; `users` ne l'avait jamais reçue. Le navigateur ne les écrit
         nulle part — mesuré, zéro occurrence — donc rien ne se ferme ici. */
      allow update: if isAdmin()
                    || (uid() == userId
                        && request.resource.data.get('supReadAdmin', 0) == resource.data.get('supReadAdmin', 0)
                        && request.resource.data.get('mollieCustomerId', '') == resource.data.get('mollieCustomerId', '')
                        && request.resource.data.get('mollieMandateId', '') == resource.data.get('mollieMandateId', '')
                        && request.resource.data.get('mollieCardSetupAt', 0) == resource.data.get('mollieCardSetupAt', 0)
                        && request.resource.data.get('cardSetupReason', '') == resource.data.get('cardSetupReason', ''));
      /* L'EFFACEMENT PASSE PAR LE SERVEUR, ET PAR LUI SEUL (12/10/2026).
         « Il était là ce matin », et il n'a laissé AUCUNE ligne dans le journal des
         départs. Les trois portes d'effacement du serveur inscrivent le départ avant
         d'effacer quoi que ce soit — mais un navigateur pouvait effacer la fiche
         LUI-MÊME, sans passer par aucune d'elles : la personne disparaît alors sans
         trace, sans conversation archivée, sans rien. L'application ne le fait plus
         depuis la v862, SAUF sur un appareil qui exécute encore une version installée
         plus ancienne — et le service worker peut en servir une pendant des semaines.

         UNE GARDE POSÉE DANS LE NAVIGATEUR SE CONTOURNE, UNE FRONTIÈRE NON. Le droit à
         l'effacement reste entier : il s'exerce par `selfDeleteAccount`, qui travaille
         sous l'Admin SDK (donc au-dessus de ces règles) et qui INSCRIT LE DÉPART avant
         de toucher à une seule fiche. Une version ancienne échoue désormais à effacer
         au lieu de réussir en silence : un compte qui reste est rattrapable, un compte
         effacé sans trace ne l'est pas. */
      allow delete: if isAdmin();
    }

    // Dossiers artisans : créés par le prestataire (statut « attente » forcé),
    // le statut ne peut être changé que par l'admin.
    match /artisans/{artisanId} {
      allow read:   if isAdmin() || uid() == artisanId;
      // Le statut « ambassadeur » est attribué UNIQUEMENT par le serveur (Cloud Function
      // assignFounderSpot, via l'Admin SDK) : l'artisan ne peut ni se l'octroyer à la
      // création, ni le modifier ensuite — sinon n'importe qui s'inscrivant après
      // l'ouverture aux clients se déclarerait ambassadeur pour toucher la commission réduite.
      // LE VERDICT SUR L'ASSURANCE APPARTIENT À L'ÉDITEUR. Le prestataire DÉCLARE —
      // « j'ai une attestation » (attente de vérification) ou « je n'en ai pas »
      // (aucune) — mais il ne prononce jamais « valide » ni « refuse » : ce sont les
      // deux mots que la console écrit après avoir OUVERT le document. Sans ce verrou,
      // il suffisait de poser `insuranceStatus: 'valide'` soi-même pour que la fiche
      // s'affiche « Validée » dans la console et que le bouton de validation s'allume —
      // et, depuis que le client lit un FAIT et non un raccourci, pour que « Assuré »
      // paraisse à côté de son nom sur l'écran où le client choisit.
      function insDeclaree() {
        return request.resource.data.get('insuranceStatus', 'attente') in ['attente', 'aucune'];
      }
      allow create: if uid() == artisanId
                    && insDeclaree()
                    && request.resource.data.status == 'attente'
                    && request.resource.data.get('founder', false) == false
                    && request.resource.data.get('refBonusJobs', 0) == 0
                    && request.resource.data.get('referralCredited', false) == false;
      // La fenêtre d'avantage fondateur (founderSince = date de départ, founderGross = CA
      // cumulé qui coupe l'avantage à 2 000 €) est tenue par le SERVEUR seul : l'artisan
      // ne peut ni la remettre à zéro ni la décaler pour prolonger son taux réduit.
      // Les métiers ACTIFS (cats) : l'artisan ne peut jamais AJOUTER un métier (sinon la
      // validation admin serait contournée) — il propose un ajout via `pendingCats`. En
      // revanche il peut RETIRER un de ses métiers depuis son compte : la nouvelle liste
      // doit être un SOUS-ENSEMBLE de l'ancienne (hasOnly = aucun ajout, retrait autorisé).
      // L'ajout reste réservé à l'admin (après validation).
      // Le crédit de parrainage (refBonusJobs = statut +5 par filleul validé) et le drapeau
      // referralCredited sont écrits par le SERVEUR seul (Cloud Function notifyArtisanApproved) :
      // l'artisan ne peut ni se créditer, ni faire baisser sa commission en gonflant ce champ.
      allow update: if isAdmin()
                    || (uid() == artisanId
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.get('founder', false) == resource.data.get('founder', false)
                        && request.resource.data.get('founderGross', 0) == resource.data.get('founderGross', 0)
                        && request.resource.data.get('founderSince', null) == resource.data.get('founderSince', null)
                        // Restitution d'une place du programme : écrite par le SERVEUR seul.
                        // Sans ce verrou, un artisan pourrait se marquer « place rendue » et
                        // empêcher qu'elle revienne au pot le jour où il est refusé.
                        && request.resource.data.get('founderReleased', false) == resource.data.get('founderReleased', false)
                        && request.resource.data.get('refBonusJobs', 0) == resource.data.get('refBonusJobs', 0)
                        && request.resource.data.get('referralCredited', false) == resource.data.get('referralCredited', false)
                        // Les champs MOLLIE de garde sont écrits par le SERVEUR seul (retour
                        // OAuth, synchro, webhook). L'acceptation de mission repose sur
                        // mollieOrgId + mollieStatus/mollieCanWork : sans ces verrous, un
                        // artisan pouvait se poser mollieCanWork:true (accepter sans compte
                        // Mollie → tous ses versements en « no_org ») ou éteindre ses
                        // relances/notifications en écrivant les drapeaux de garde.
                        && request.resource.data.get('mollieOrgId', '') == resource.data.get('mollieOrgId', '')
                        && request.resource.data.get('mollieStatus', '') == resource.data.get('mollieStatus', '')
                        && request.resource.data.get('mollieCanWork', false) == resource.data.get('mollieCanWork', false)
                        && request.resource.data.get('mollieCanPay', false) == resource.data.get('mollieCanPay', false)
                        && request.resource.data.get('mollieCanSettle', false) == resource.data.get('mollieCanSettle', false)
                        && request.resource.data.get('mollieActiveNotified', false) == resource.data.get('mollieActiveNotified', false)
                        && request.resource.data.get('mollieIssueNotified', '') == resource.data.get('mollieIssueNotified', '')
                        && request.resource.data.get('mollieRelanceAt', 0) == resource.data.get('mollieRelanceAt', 0)
                        // Ancienneté du dossier en attente : horodatée par le serveur seul.
                        // Sinon l'artisan pourrait remettre son compteur à zéro et masquer
                        // un blocage qui dure.
                        && request.resource.data.get('mollieSince', 0) == resource.data.get('mollieSince', 0)
                        && request.resource.data.get('mollieSinceEstime', false) == resource.data.get('mollieSinceEstime', false)
                        && request.resource.data.get('cats', []).hasOnly(resource.data.get('cats', []))
                        // Le statut de l'assurance ne se décerne pas soi-même : il reste
                        // tel quel, ou redevient une simple déclaration (une nouvelle
                        // attestation déposée repart « attente »).
                        && (request.resource.data.get('insuranceStatus', '') == resource.data.get('insuranceStatus', '')
                            || insDeclaree()));
      // Droit à l'effacement (RGPD) : l'artisan peut supprimer son propre dossier.
      // Même frontière que `users` : l'effacement passe par `selfDeleteAccount`, qui
      // inscrit le départ avant d'effacer. Voir le bloc `users`.
      allow delete: if isAdmin();
    }

    // Souhaits de services envoyés par les clients (« boîte à idées » du profil) :
    // chacun crée les siens (clientUid = son uid) ; seul l'admin lit/gère l'ensemble
    // pour recenser la demande. Pas de modification a posteriori par le client.
    match /serviceWishes/{wishId} {
      allow read:   if isAdmin();
      allow create: if signedIn() && request.resource.data.clientUid == uid();
      allow update, delete: if isAdmin();
    }

    // Dossiers conciergerie (mandataires) : créés par la structure (statut « attente »
    // forcé), le statut ne peut être changé que par l'admin. Les données
    // opérationnelles (clients, commandes, apport) sont écrites par la conciergerie
    // elle-même, sans jamais modifier son propre statut.
    match /concierges/{concId} {
      allow read:   if isAdmin() || uid() == concId;
      allow create: if uid() == concId
                    && request.resource.data.status == 'attente';
      // La conciergerie écrit ses données opérationnelles sans toucher à son statut ;
      // le marqueur de versement (retroPaid) ET la rétribution cumulée (earn) restent
      // écrits par le serveur/l'admin seuls — sinon une conciergerie pourrait s'afficher
      // « versée » à tort ou gonfler sa rétribution.
      allow update: if isAdmin()
                    || (uid() == concId
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.get('retroPaid', '') == resource.data.get('retroPaid', '')
                        && request.resource.data.get('earn', 0) == resource.data.get('earn', 0));
      // Droit à l'effacement (RGPD) : la conciergerie peut supprimer son dossier.
      // Même frontière que `users` et `artisans`.
      allow delete: if isAdmin();
    }

    // Registre comptable IMMUABLE (source de vérité). Écrit UNIQUEMENT par le serveur
    // (Cloud Function via l'Admin SDK, qui contourne ces règles) : aucun client ne peut
    // créer, modifier ni supprimer une écriture — donc rien ne se perd par bug ou manip.
    // Lecture : l'admin, plus la partie concernée (artisan / client) pour ses propres pièces.
    // Journal des départs : qui a supprimé son compte, quand, et où en était son dossier.
    // Écrit par le SERVEUR seul (avant l'effacement des fiches), lu par l'administrateur
    // seul — il y figure des personnes qui ont justement demandé leur effacement, et le
    // serveur purge les lignes échues chaque jour.
    /* LES CONVERSATIONS DE SUPPORT GÉNÉRAL DES COMPTES PARTIS. Écrites par le SERVEUR
       seul, juste avant l'effacement de la fiche — c'est une pièce de litige, pas une
       donnée d'application. Personne ne les écrit depuis un navigateur, et seul
       l'administrateur les lit. */
    match /supportArchive/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /comptesSupprimes/{uid} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /ledger/{entryId} {
      allow read:  if isAdmin()
                   || (signedIn() && resource.data.providerUid == uid())
                   || (signedIn() && resource.data.clientUid == uid());
      allow write: if false;
    }

    // Compteurs de numérotation des factures (séquence par intervenant). Écrits et lus
    // UNIQUEMENT par le serveur (Cloud Function / Admin SDK) : aucun accès client, pour
    // garantir l'unicité et la continuité de la numérotation.
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // Signalements de contenu ou de comportement. Créés par la Cloud Function
    // `reportContent` (Admin SDK, qui contourne ces règles) et par elle seule :
    // l'auteur d'un signalement est celui qui est authentifié côté serveur, jamais un
    // champ que le client remplit. Lecture réservée à l'admin — un signalement nomme
    // une personne, il n'a rien à faire sous les yeux d'un autre utilisateur, pas même
    // de la personne signalée.
    match /reports/{reportId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // Demandes de prestation
    match /requests/{reqId} {
      function isClient()   { return signedIn() && resource.data.clientUid == uid(); }
      function isProvider() { return signedIn() && resource.data.providerUid == uid(); }

      // Ensemble des champs modifiés par une mise à jour.
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      // Champs CALCULÉS PAR LE SERVEUR (settleCommission) : aucun client ne les écrit.
      // Le montant, la commission, le net, le n° de facture… viennent du registre serveur.
      function serverKeys() {
        return ['grossTotal','netAmount','commissionAmount','commissionPct','commissionBase',
                'saleInvoiceNo','commissionSettled','settledAt','molliePaymentId','molliePayout',
                // Règlement de l'indemnité d'annulation : écrit par le SERVEUR seul
                // (capture Mollie + commission + net). Sans ce verrou, une partie
                // pourrait se marquer « indemnité réglée » sans qu'aucun argent n'ait bougé.
                'cancelFeeSettled','cancelFeeCommission','cancelFeeCommissionPct','cancelFeeNet',
                // ARRHES RÉELLEMENT PRÉLEVÉES : le paiement, le montant, la part et
                // l'état viennent du SERVEUR. Sans ce verrou, un client pourrait se
                // déclarer « arrhes prélevées » sans qu'aucun euro ait bougé — et le
                // règlement lui déduirait du solde une somme qu'il n'a jamais payée.
                'arrhesPaymentId','arrhesAmount','arrhesPct','arrhesStatut','arrhesMotif',
                'arrhesLien','arrhesAt','arrhesRenduAt','cancelFeePct',
                // CE QUI EST PARTI AUX PRESTATAIRES : combien ont été visés, prévenus,
                // courriellés, et la raison quand personne ne l'a été. La console
                // l'affiche comme un FAIT ; laissé libre, un compte écrirait
                // « 12 prestataires prévenus » sur sa propre demande et la console le
                // répéterait. Seules les fonctions l'écrivent.
                'diffusion',
                // LA RELANCE DU CRÉNEAU PASSÉ : pour quel rendez-vous elle est partie, et
                // quand. C'est ce qui empêche de prévenir deux fois, et c'est ce qui
                // donne au client ses douze heures de réponse avant la fermeture. Laissé
                // libre, un compte se déclarerait « déjà relancé » pour repousser
                // indéfiniment l'expiration de sa demande, empreinte bancaire comprise.
                // Il n'a rien à y écrire : la clé s'invalide d'elle-même dès qu'il
                // change sa date.
                'relancePour','relanceAt',
                // LE RÈGLEMENT SUR MANDAT (23/10/2026) : ce que le serveur constate
                // d'un encaissement. Laissés libres, un compte se déclarerait « versé »
                // ou effacerait la trace d'une empreinte morte — c'est-à-dire la seule
                // chose qui dit que le prestataire n'a pas été payé.
                'arrhesPayout','arrhesPayoutIssue','arrhesPayoutMotif','arrhesPayoutNet',
                'reglementAjourne','reglementAjourneAt',
                'empreinteMorteAu','empreinteMorteAt','commissionNonRetenue',
                // LE MONTANT CONSENTI (23/10/2026). C'est le plafond du SILENCE :
                // `autoValidate` ne valide seule que jusqu'à la somme que le client a
                // vue. Il était tiré du montant de l'empreinte — donc inexistant sur une
                // commande couverte par le mandat, où ce plafond devenait inerte. Laissé
                // libre, un compte s'écrirait un plafond à sa convenance : le client en
                // se gonflant un consentement, un autre en le mettant à zéro pour
                // bloquer toute validation automatique.
                'totalConsenti','totalConsentiAt',
                // L'ENREGISTREMENT DE LA CARTE À LA COMMANDE : quel paiement à 0,00 € a
                // été ouvert, ce que Mollie en a dit, et ce qui couvre la prestation.
                // C'est `cardSetupStatus`/`couverturePar` qui disent pourquoi une demande
                // a été ouverte aux prestataires sans empreinte ; un compte qui pourrait
                // les écrire se déclarerait couvert sans qu'aucune carte soit mémorisée.
                'cardSetupPaymentId','cardSetupAt','cardSetupStatus',
                'couverturePar','couvertureMotif','mollieMandateId'];
      }
      // TERMES DU CONTRAT, figés dès l'acceptation : le tarif €/h, la majoration, l'unité,
      // le service et l'estimation convenue ne changent plus. Seule la DURÉE RÉELLE
      // (finalHours) peut bouger — déclarée par l'artisan, validée par le client.
      function contractKeys() {
        return ['rate','boost','boostEur','unit','service','serviceName','duration','clientUid'];
      }
      /* LES PRIX DÉTAILLÉS, FIGÉS DÈS L'ACCEPTATION — ET LUS PAR LES DEUX BRANCHES.
         `acts` et `options` décident du TOTAL à prélever, et ils n'étaient épinglés NULLE
         PART : mesuré contre le moteur, le prestataire comme le client pouvaient réécrire
         un prix de 35 € en 5 000 € après acceptation. Avec le mandat, le plafond de la
         banque ne protège plus : ce qui tient est que le client valide un total — encore
         faut-il que ce total ne soit pas réécrit sous lui.
         ILS NE REJOIGNENT PAS `contractKeys()`, et c'est mesuré aussi : la branche du
         CLIENT ne la lit pas, elle porte sa propre liste parce que le coup de pouce doit
         pouvoir MONTER pendant la recherche. Deux listes pour la même question finissent
         par ne plus dire la même chose — celle-ci est donc nommée dans les deux. */
      function prixKeys() {
        return ['acts','options'];
      }

      /* UN FIL DE DISCUSSION NE PEUT QUE GRANDIR, ET L'ON NE SIGNE PAS À LA PLACE
         DE L'AUTRE (23/10/2026). `messages` n'était piné nulle part : chaque partie
         pouvait ajouter une ligne portant le `from` de l'AUTRE — ou « admin », que
         l'application rend comme venant de Ti-Services et qui déclenche même une
         notification « Ti-Services · Support » — et surtout réécrire ou vider le
         tableau entier. Or les CGU (art. 6 et 7) désignent ces messages comme
         éléments de preuve, et la console les relit pour arbitrer : une preuve que
         chaque partie peut réécrire n'en est pas une.

         LE MÊME RISQUE ÉTAIT DÉJÀ NOMMÉ TROIS LIGNES PLUS BAS, pour `supportPro` :
         « il pouvait y écrire un message étiqueté "admin", que l'artisan recevait
         comme venant officiellement de Ti-Services (phishing) ». Ce fil-là était
         fermé ; le fil principal ne l'avait jamais été.

         LA TAILLE DOIT MONTER D'EXACTEMENT UN, ce qui interdit d'effacer comme de
         remplacer, et le message ajouté porte le rôle de celui qui écrit. On garde
         ainsi `arrayUnion`, donc l'envoi HORS LIGNE continue de marcher — une porte
         serveur l'aurait coûté, et sur cette île c'est le cas ordinaire. */
      function filAjout(ancien, nouveau, role) {
        return nouveau.size() == ancien.size() + 1
               && nouveau[ancien.size()].get('from', '') == role;
      }
      function filSain(champ, role) {
        return !changed().hasAny([champ])
               || filAjout(resource.data.get(champ, []), request.resource.data.get(champ, []), role);
      }

      // Lecture : client propriétaire, prestataire assigné, tout artisan validé
      // (pour découvrir les demandes ouvertes à accepter), admin.
      allow read: if isAdmin() || isClient() || isProvider() || isValidArtisan();

      // Création par le client, clientUid = soi-même. Statut « pending » (bêta, sans
      // paiement) OU « pending_payment » (prod : la demande n'est PAS ouverte aux
      // prestataires tant que la carte n'est pas autorisée — bascule faite par le webhook
      // Mollie côté serveur, jamais par le client).
      // À LA CRÉATION, PERSONNE NE S'ATTRIBUE LA PREUVE DU PAIEMENT. Le serveur seul
      // écrit `molliePaymentAuthorized` (webhook Mollie ou relecture du paiement), et
      // c'est sur ce champ que la diffusion des alertes s'appuie pour savoir qu'une
      // demande est garantie. Laissé libre, il se déclarait soi-même : il suffisait
      // d'écrire une demande déjà « publiée » avec le drapeau, et un e-mail partait à
      // tous les prestataires depuis notre domaine sans qu'un centime soit engagé.
      // Les champs financiers calculés (serverKeys) sont verrouillés de la même façon —
      // ils l'étaient déjà à la mise à jour, pas à la création.
      allow create: if signedIn()
                    && request.resource.data.clientUid == uid()
                    && (request.resource.data.status == 'pending'
                        || request.resource.data.status == 'pending_payment')
                    && !request.resource.data.keys().hasAny(serverKeys())
                    && !request.resource.data.keys().hasAny(
                         ['molliePaymentAuthorized','molliePaymentStatus','molliePaymentCaptured']);

      // Mise à jour — chaque rôle ne peut toucher QUE ce qui le concerne, et JAMAIS
      // les champs financiers calculés par le serveur (intégrité de la commission).
      allow update: if isAdmin()

        // « Premier arrivé » : un artisan validé prend une demande encore pending.
        // Il s'assigne, sans toucher aux montants ni aux termes du contrat.
        // Demande DIRIGÉE (directed) : seul l'artisan précisément demandé peut la prendre.
        || (isValidArtisan()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && request.resource.data.providerUid == uid()
            // JAMAIS sa propre demande. Un prestataire peut commander un renfort à un
            // confrère : il est alors le client de cette demande. Sans ce garde-fou, il
            // pourrait s'attribuer une mission fictive et gonfler ses statistiques.
            && resource.data.clientUid != uid()
            /* ACCEPTER N'EXIGE PLUS MOLLIE — décision de l'éditeur (09/10/2026).
               La porte demandait l'organisation connectée ET l'autorisation d'encaisser.
               Elle protégeait un vrai risque — sans destinataire, Mollie ne peut router
               nulle part — mais elle coûtait plus qu'elle ne rapportait : un prestataire
               validé voyait des demandes qu'il ne pouvait pas prendre, et une demande
               mourait faute de preneur pendant qu'il remplissait un formulaire.

               CE QUI SE PASSE SANS MOLLIE EST CONNU ET TENU : le client est débité
               normalement à la validation, la totalité reste sur le solde Ti-Services, le
               net dû est inscrit sur la demande (`molliePayoutNet`, état `no_org`), le
               registre comptable l'enregistre comme une DETTE et non comme un revenu,
               l'artisan est prévenu et l'administrateur alerté. Le rattrapage est
               automatique s'il active Mollie pendant que le paiement est encore routable,
               manuel ensuite.

               IL NE SERA DONC PAYÉ QU'UNE FOIS MOLLIE ACTIVÉ, et c'est écrit devant lui
               AVANT qu'il accepte, pas découvert après. Ce qui reste verrouillé, c'est ce
               qui compte vraiment : il ne peut pas se déclarer lui-même « autorisé à
               encaisser » (l. 133-135), et aucun euro ne lui parvient sans que Mollie ait
               vérifié son identité et son IBAN. */
            && (resource.data.get('directed', false) == false
                || resource.data.get('preferredProviderUid', '') == uid())
            && !changed().hasAny(serverKeys())
            && !changed().hasAny(contractKeys()))

        // Demande DIRIGÉE déclinée : l'artisan PRÉCISÉMENT demandé refuse (pending -> declined).
        // Il ne s'assigne pas, ne touche ni aux montants ni au contrat. Le client décidera
        // ensuite d'ouvrir la demande à tous les artisans ou de l'annuler.
        || (isValidArtisan()
            && resource.data.status == 'pending'
            && resource.data.get('directed', false) == true
            && resource.data.get('preferredProviderUid', '') == uid()
            && request.resource.data.status == 'declined'
            && request.resource.data.get('providerUid', null) == null
            && !changed().hasAny(serverKeys())
            && !changed().hasAny(contractKeys()))

        // CLIENT propriétaire : il suit, VALIDE, conteste, annule ou relance (no-show).
        // Il ne fixe NI le tarif, NI la durée réelle (finalHours), NI les montants serveur.
        // Il peut au plus libérer le prestataire (providerUid -> null lors d'une relance).
        // EXCEPTION « coup de pouce » : tant que la demande est encore `pending` (aucun
        // artisan n'a répondu), le client peut RELEVER le boost pour re-solliciter tout le
        // monde. Le boost ne peut que MONTER, et jamais une fois la mission acceptée (il
        // redevient un terme figé du contrat). Le montant recalculé (`total`) et l'horodatage
        // de relance (`reboostedAt`) accompagnent ce coup de pouce.
        || (isClient()
            && !changed().hasAny(serverKeys())
            && !changed().hasAny(['finalHours'])
            && !changed().hasAny(['rate','unit','service','serviceName','duration','clientUid'])
            && !changed().hasAny(prixKeys())
            // CHACUN SON FIL DE SUPPORT. Le fil artisan↔Ti-Services (supportPro) n'est
            // pas au client : il pouvait y écrire un message étiqueté « admin », que
            // l'artisan recevait comme venant officiellement de Ti-Services (phishing).
            && !changed().hasAny(['supportPro'])
            // Son propre fil, signé de son propre rôle (voir filSain).
            && filSain('messages', 'client')
            && filSain('supportClient', 'client')
            // VERROU PAIEMENT : le client ne peut JAMAIS ouvrir lui-même sa demande au pool.
            // La bascule pending_payment/payment_failed -> pending est réservée au serveur
            // (webhook Mollie). Depuis un statut « paiement », il ne peut que renoncer.
            && (!(resource.data.status == 'pending_payment' || resource.data.status == 'payment_failed')
                || request.resource.data.status == 'expired'
                || request.resource.data.status == 'cancelled')
            && (!changed().hasAny(['boost'])
                || (resource.data.status == 'pending'
                    && request.resource.data.boost >= resource.data.get('boost', 0)))
            // Coup de pouce en euros : relevable UNIQUEMENT à la hausse, tant que pending.
            && (!changed().hasAny(['boostEur'])
                || (resource.data.status == 'pending'
                    && request.resource.data.boostEur >= resource.data.get('boostEur', 0)))
            && (request.resource.data.get('providerUid', null) == resource.data.get('providerUid', null)
                || request.resource.data.get('providerUid', null) == null)
            // LA NOTE EST L'AVIS DU CLIENT SUR UNE PRESTATION FAITE ET RÉGLÉE. C'est ce
            // qui la rend vérifiable : elle ne peut être écrite ni avant la prestation,
            // ni sur la demande de quelqu'un d'autre (isClient() le tient déjà), et elle
            // reste dans 1..5 — une note hors bornes fausserait toute moyenne future.
            && (!changed().hasAny(['rating','ratedAt'])
                || (resource.data.status == 'paid'
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5)))

        // PRESTATAIRE assigné : il fait avancer la mission et DÉCLARE la durée réelle
        // (finalHours) — le seul levier d'ajustement légitime. Jamais le tarif ni les
        // montants. Il peut se désister (providerUid -> null).
        || (isProvider()
            && !changed().hasAny(serverKeys())
            && !changed().hasAny(contractKeys())
            && !changed().hasAny(prixKeys())
            // Symétrique du verrou client : le fil client↔Ti-Services (supportClient)
            // n'est pas au prestataire.
            && !changed().hasAny(['supportClient'])
            // LE POURBOIRE EST AU CLIENT. Écrit par lui à la validation, dans la même
            // opération que le règlement. Le prestataire ne s'en donne pas.
            && !changed().hasAny(['tip'])
            // Son propre fil, signé de son propre rôle (voir filSain).
            && filSain('messages', 'pro')
            && filSain('supportPro', 'pro')
            // Et il ne se note pas lui-même.
            && !changed().hasAny(['rating','ratedAt'])
            && (request.resource.data.get('providerUid', null) == resource.data.get('providerUid', null)
                || request.resource.data.get('providerUid', null) == null));

      // Le client ne peut supprimer que SA demande encore « pending » (annulation avant
      // acceptation). Une demande acceptée / en cours / réglée est une pièce comptable :
      // seul l'admin peut l'effacer (RGPD). Les commissions restent de toute façon dans
      // le registre immuable `ledger`, hors de portée du client.
      allow delete: if isAdmin() || (isClient() && (resource.data.status == 'pending' || resource.data.status == 'declined' || resource.data.status == 'pending_payment' || resource.data.status == 'payment_failed'));

      /* LA SOUS-COLLECTION `messages` EST RETIRÉE (23/10/2026). Elle était ouverte en
         création au client et au prestataire SANS liste de champs fermée et SANS
         bornes de taille — les trois garde-fous appliqués partout ailleurs. Et rien
         ne l'écrivait ni ne la lisait : mesuré, zéro occurrence dans l'application
         comme dans les fonctions. Le fil vit dans le CHAMP `messages` de la demande.
         Une porte que personne n'emprunte et que rien ne borne finit par servir à
         quelqu'un d'autre ; elle retombe donc dans le refus par défaut. */

      /* CONTRE-PROPOSITIONS : « je peux, mais à un autre moment ». Un prestataire
         validé ne peut RIEN écrire sur une demande qui n'est pas la sienne, et c'est
         bien ainsi : la proposition vit donc à côté, une par prestataire.

         L'IDENTIFIANT EST SON UID. Pas un identifiant libre : il ne peut donc pas en
         semer cent sur la même demande, et reproposer remplace sa proposition au lieu
         d'en ajouter une. Liste de champs FERMÉE et tailles bornées, comme partout où
         un compte écrit ce qu'un autre écran affiche.

         ET JAMAIS SUR LA DEMANDE DE QUELQU'UN D'AUTRE QUE SOI : un prestataire peut
         commander un renfort, il est alors le client ; se contre-proposer à soi-même
         n'aurait aucun sens et fausserait ses statistiques. */
      match /propositions/{proUid} {
        function parent() {
          return get(/databases/$(database)/documents/requests/$(reqId)).data;
        }
        allow read: if isAdmin() || (signedIn() && uid() == proUid) || (signedIn() && parent().clientUid == uid());
        allow create, update: if isValidArtisan()
          && uid() == proUid
          && parent().status == 'pending'
          /* DÈS QUE LE CLIENT A TRANCHÉ, ON N'EN REÇOIT PLUS. Accepter une proposition
             rend la demande DIRIGÉE : elle disparaît du fil des autres, mais son statut
             reste « pending » (le prestataire choisi doit encore la confirmer) — sans
             cette ligne, un confrère pourrait continuer d'en proposer, et le client
             verrait arriver des créneaux pour une prestation déjà décidée. */
          && parent().get('directed', false) == false
          && parent().clientUid != uid()
          && request.resource.data.keys().hasOnly(['providerUid','providerName','dateISO','slot','at'])
          && request.resource.data.providerUid == uid()
          && request.resource.data.providerName is string
          && request.resource.data.providerName.size() <= 60
          && request.resource.data.dateISO is string
          && request.resource.data.dateISO.size() == 10
          && request.resource.data.slot is string
          && request.resource.data.slot.size() <= 5;
        // Le prestataire retire la sienne ; le client écarte celle qu'il refuse.
        allow delete: if isAdmin() || (signedIn() && uid() == proUid) || (signedIn() && parent().clientUid == uid());
      }

      // Détails privés (adresse exacte, GPS, accès) : créés par le client,
      // lisibles seulement par le client, l'artisan ASSIGNÉ et l'admin
      // (jamais par les artisans qui parcourent les demandes ouvertes).
      match /private/{doc} {
        function parent() {
          return get(/databases/$(database)/documents/requests/$(reqId)).data;
        }
        allow create: if signedIn() && parent().clientUid == uid();
        allow read:   if isAdmin() || parent().clientUid == uid() || parent().providerUid == uid();
        allow update, delete: if isAdmin() || parent().clientUid == uid();
      }
    }
  }
}
