{
  "name": "Ti-Services",
  "short_name": "Ti-Services",
  "description": "Mise en relation de petits services à la demande à Saint-Barthélemy — ménage, garde d'enfants, jardinage.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FBF7F4",
  "theme_color": "#F26A4B",
  "categories": ["lifestyle", "productivity"],
  "//": "Le manifeste SE CITE lui-même : c'est ce qui permet a navigator.getInstalledRelatedApps() de repondre « oui, cette application est installee sur cet appareil » — depuis la fenetre d'app comme depuis un onglet. L'adresse est RELATIVE : elle se resout contre l'adresse du manifeste, donc elle tombe juste sur chaque hote (ti-services.fr, t-service-prod.web.app) sans qu'on en cite aucun.",
  "prefer_related_applications": false,
  "related_applications": [
    { "platform": "webapp", "url": "./manifest.webmanifest" }
  ],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
